# ignore Docker volumes
/volumes/*

# ignore everything in the root except the "wp-content" directory.
/*
!wp-content/


# ignore everything in the "wp-content" directory, except:
# mu-plugins, plugins, and themes directories
wp-content/*
!wp-content/mu-plugins/
!wp-content/plugins/
!wp-content/themes/
!wp-content/fluent-snippet-storage/

# ignore all mu-plugins, plugins, and themes
# unless explicitly whitelisted at the end of this file
wp-content/mu-plugins/*
wp-content/plugins/*
wp-content/themes/*

# ignore all files starting with . or ~
.*
~*

# ignore node dependency directories (used by grunt)
node_modules/

# ignore OS generated files
*~
ehthumbs.db
Thumbs.db
.DS_Store

# ignore version files
.svn
.cvs

# ignore backups and swap files
*.bak
*.swp

# ignore Editor files
*.sublime-project
*.sublime-workspace
*.komodoproject
/.vscode

# ignore log files and databases
*.log
*.sql
*.sqlite

# ignore compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# ignore packaged files
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# large/disallowed file types
# a CDN should be used for these
*.hqx
*.bin
*.exe
*.dll
*.deb
*.dmg
*.iso
*.img
*.msi
*.msp
*.msm
*.mid
*.midi
*.kar
*.mp3
*.ogg
*.m4a
*.ra
*.3gpp
*.3gp
*.mp4
*.mpeg
*.mpg
*.mov
*.webm
*.flv
*.m4v
*.mng
*.asx
*.asf
*.wmv
*.avi

# -------------------------
# BEGIN Whitelisted Files
# -------------------------

# commit seeds
!seeds/
!seeds/*

# track these files, if they exist
!.gitignore
!.editorconfig
!.phpcs.xml.dist
!README.md
!CHANGELOG.md
!composer.json
!docker-compose.yml
!.scss-lint.ym
!.nvmrc

# track favicon files, if they exist
!android-chrome-*.png
!apple-touch-icon*.png
!browserconfig.xml
!favicon*.png
!favicon*.ico
!manifest.json
!mstile-*.png
!safari-pinned-tab.svg
!site.webmanifest

# track these mu-plugins, plugins, and themes
# add your own entries here
!wp-content/mu-plugins/free-product-gift.php
!wp-content/mu-plugins/free-voucher-gift.php
!wp-content/mu-plugins/cart-calculation-fixes.php
!wp-content/plugins/custom-checkout-fields/
# !wp-content/plugins/example-plugin/
# !wp-content/themes/example-theme/
!wp-content/themes/blocksy/
!wp-content/themes/blocksy-child/